<Window
    x:Class="GooglePhotosBackup.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Google Photos Backup">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <NavigationView x:Name="Navigation" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False" SelectionChanged="Navigation_SelectionChanged"
                    Header="Overview" Background="Transparent">
        <NavigationView.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <BitmapImage x:Key="AppMarkImage" UriSource="ms-appx:///Assets/app-icon.png" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <BitmapImage x:Key="AppMarkImage" UriSource="ms-appx:///Assets/app-icon-dark.png" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Default">
                        <BitmapImage x:Key="AppMarkImage" UriSource="ms-appx:///Assets/app-icon.png" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </NavigationView.Resources>
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Overview" Tag="overview" ToolTipService.ToolTip="Overview" AutomationProperties.Name="Overview">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Folders" Tag="folders" ToolTipService.ToolTip="Folders" AutomationProperties.Name="Folders">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Folder" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Connected devices" Tag="devices" ToolTipService.ToolTip="Connected devices" AutomationProperties.Name="Connected devices">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Devices" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="iCloud Photos" Tag="icloud" ToolTipService.ToolTip="iCloud Photos" AutomationProperties.Name="iCloud Photos">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Sync" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Activity" Tag="activity" ToolTipService.ToolTip="Activity" AutomationProperties.Name="Activity">
                <NavigationViewItem.Icon><SymbolIcon Symbol="List" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Settings" Tag="settings" ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <Grid Padding="32,20,32,28" MaxWidth="1000" HorizontalAlignment="Stretch">
            <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="24">
                    <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                        <Image x:Name="AppMarkImageView" Source="{ThemeResource AppMarkImage}" Width="72" Height="72"
                               AutomationProperties.Name="Google Photos Backup app icon" />
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="Your photos, backed up" Style="{ThemeResource TitleTextBlockStyle}" />
                            <TextBlock Text="Keep selected folders in Google Photos from this PC."
                                       TextWrapping="Wrap" Opacity="0.75" />
                        </StackPanel>
                    </StackPanel>
                    <InfoBar x:Name="NoticeBar" IsOpen="False" IsClosable="True" Severity="Informational" />
                    <StackPanel Spacing="8">
                        <TextBlock Text="ACCOUNT" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="AccountText" Text="Not connected" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <Button x:Name="OverviewSignInButton" Content="Connect Google Photos"
                                Click="SignIn_Click" AutomationProperties.Name="Connect Google Photos account" />
                    </StackPanel>
                    <StackPanel Spacing="10">
                        <TextBlock Text="BACKUP" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="StatusText" Text="Choose a folder to get started."
                                   TextWrapping="Wrap" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <ProgressBar x:Name="RunProgress" Minimum="0" Maximum="100" Value="0" Height="8"
                                     AutomationProperties.Name="Backup progress" />
                        <TextBlock x:Name="ProgressText" Text="No backup running" Opacity="0.75"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="StartButton" Content="Back Up Now" Click="Start_Click"
                                    Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="Start backup" />
                            <Button x:Name="PauseButton" Content="Pause" Click="Pause_Click"
                                    IsEnabled="False" AutomationProperties.Name="Pause backup" />
                            <Button x:Name="ResumeButton" Content="Resume" Click="Resume_Click"
                                    IsEnabled="False" AutomationProperties.Name="Resume backup" />
                            <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click"
                                    IsEnabled="False" AutomationProperties.Name="Cancel backup" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="NEXT BACKUP" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="SelectionSummary" Text="No folders selected" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="DevicesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18">
                    <TextBlock Text="Connected devices" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="Choose specific media from an unlocked Android phone paired with adb. Copies are staged privately before upload; source media is always kept. iPhone, MTP and PTP devices appear when Windows exposes them, but importing them is not available in this build."
                               TextWrapping="Wrap" Opacity="0.75" />
                    <InfoBar x:Name="DeviceNotice" IsOpen="False" IsClosable="True" Severity="Informational" />
                    <ListView x:Name="DevicesList" Height="120" SelectionMode="Single" SelectionChanged="DevicesList_SelectionChanged"
                              AutomationProperties.Name="Connected media devices" />
                    <Button x:Name="RefreshDevicesButton" Content="Refresh devices" Click="RefreshDevices_Click" />
                    <TextBlock Text="MEDIA" Style="{ThemeResource CaptionTextBlockStyle}" />
                    <ListView x:Name="DeviceMediaList" Height="300" SelectionMode="Multiple" DisplayMemberPath="Name"
                              AutomationProperties.Name="Selected connected device media" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="StageDeviceMediaButton" Content="Add selected media to backup" Click="StageDeviceMedia_Click"
                                Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                    <TextBlock Text="Storage reclaim is unavailable: this app never deletes source media from a connected device."
                               TextWrapping="Wrap" Opacity="0.65" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="FoldersPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18">
                    <TextBlock Text="Choose folders" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="Add photo and video folders from this PC. Each folder can become an album with the same name in Google Photos. Files stay on your PC."
                               TextWrapping="Wrap" Opacity="0.75" />
                    <ListView x:Name="FoldersList" Height="340" SelectionMode="Single"
                              AutomationProperties.Name="Selected backup folders" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AddFolderButton" Content="Add folder" Click="AddFolder_Click"
                                Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="RemoveFolderButton" Content="Remove selected" Click="RemoveFolder_Click" />
                    </StackPanel>
                    <TextBlock Text="Changes to the folder list are saved automatically. Folder choices cannot change while a backup is running."
                               TextWrapping="Wrap" Opacity="0.65" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ICloudPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18">
                    <TextBlock Text="iCloud Photos" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="Back up your iCloud Photos library to Google Photos. Sign in to your Apple Account, then approve the sign-in with the code Apple sends you. Connect Google Photos in Overview before starting."
                               TextWrapping="Wrap" Opacity="0.75" />
                    <TextBlock Text="Apple must allow iCloud Photos web access for this transfer. Advanced Data Protection may prevent access. This sign-in is separate from iCloud for Windows; if web access is unavailable, use the Folders page to back up a local copy instead."
                               TextWrapping="Wrap" Opacity="0.75" />
                    <InfoBar x:Name="ICloudNotice" IsOpen="False" IsClosable="True" Severity="Informational" />
                    <TextBlock x:Name="ICloudAccountStatus" Text="Not connected to iCloud" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBox x:Name="ICloudAccountBox" Header="Apple Account email" PlaceholderText="name@example.com"
                             AutomationProperties.Name="Apple Account email" />
                    <PasswordBox x:Name="ICloudPasswordBox" Header="Apple Account password"
                                 AutomationProperties.Name="Apple Account password" />
                    <Button x:Name="ICloudSignInButton" Content="Sign in to iCloud" Click="ICloudSignIn_Click"
                            AutomationProperties.Name="Sign in to iCloud Photos" />
                    <StackPanel x:Name="ICloudTwoFactorPanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock x:Name="ICloudCodeModeText" Text="Enter the six-digit code shown on your trusted Apple device."
                                   TextWrapping="Wrap" />
                        <Button x:Name="ICloudUseDeviceButton" Content="Use trusted device code" Click="ICloudUseDevice_Click"
                                Visibility="Collapsed" />
                        <StackPanel x:Name="ICloudPhoneChoices" Spacing="8" Visibility="Collapsed">
                            <ComboBox x:Name="ICloudPhoneBox" Header="Text a code to" Width="280"
                                      AutomationProperties.Name="Trusted phone for Apple verification" />
                            <Button x:Name="ICloudSendCodeButton" Content="Send text message" Click="ICloudSendCode_Click" />
                        </StackPanel>
                        <TextBox x:Name="ICloudCodeBox" Header="Verification code" MaxLength="6" InputScope="Number"
                                 AutomationProperties.Name="Apple verification code" />
                        <Button x:Name="ICloudVerifyButton" Content="Verify code" Click="ICloudVerify_Click" />
                    </StackPanel>
                    <TextBlock Text="BACKUP TO GOOGLE PHOTOS" Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock x:Name="ICloudBackupStatus" Text="Connect both accounts to begin." TextWrapping="Wrap" />
                    <ProgressBar x:Name="ICloudProgress" Minimum="0" Maximum="100" Height="8"
                                 AutomationProperties.Name="iCloud backup progress" />
                    <TextBlock x:Name="ICloudProgressText" Text="No iCloud backup running" TextWrapping="Wrap" Opacity="0.75" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ICloudStartButton" Content="Back Up iCloud Photos" Click="ICloudStart_Click" IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="ICloudPauseButton" Content="Pause" Click="ICloudPause_Click" IsEnabled="False" />
                        <Button x:Name="ICloudResumeButton" Content="Resume" Click="ICloudResume_Click" IsEnabled="False" />
                    </StackPanel>
                    <TextBlock Text="This is a backup-only transfer. Originals remain in iCloud and no source photo is deleted. A paused or interrupted run can resume from confirmed uploads."
                               TextWrapping="Wrap" Opacity="0.75" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ActivityPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18">
                    <TextBlock Text="Activity" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="Completed and canceled runs on this PC." Opacity="0.75" />
                    <ListView x:Name="ActivityList" Height="440" SelectionMode="None"
                              AutomationProperties.Name="Backup history" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="22">
                    <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" />
                    <StackPanel Spacing="10">
                        <TextBlock Text="GOOGLE ACCOUNT" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="SettingsAccountText" Text="Not connected" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="SettingsSignInButton" Content="Sign in with Google" Click="SignIn_Click" />
                            <Button x:Name="DisconnectButton" Content="Disconnect" Click="Disconnect_Click" />
                        </StackPanel>
                        <TextBlock Text="If the embedded sign-in cannot complete, paste a gpmc auth_data credential below. It will be checked with Google before being saved for this Windows user."
                                   TextWrapping="Wrap" Opacity="0.75" />
                        <PasswordBox x:Name="CredentialBox" Header="Advanced: gpmc auth_data"
                                     PlaceholderText="Paste credential" AutomationProperties.Name="Paste gpmc auth_data credential" />
                        <Button x:Name="ConnectCredentialButton" Content="Connect with credential"
                                Click="ConnectCredential_Click" />
                    </StackPanel>
                    <StackPanel Spacing="10">
                        <TextBlock Text="UPLOAD" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <ComboBox x:Name="QualityBox" Header="Upload quality" Width="360"
                                  SelectionChanged="Quality_SelectionChanged">
                            <ComboBoxItem Content="Original quality (Pixel XL profile)" Tag="original" />
                            <ComboBoxItem Content="Storage saver (Pixel 2 profile)" Tag="saver" />
                            <ComboBoxItem Content="Original quality (uses storage)" Tag="quota" />
                        </ComboBox>
                        <TextBlock Text="Google controls upload availability and storage accounting. Pixel XL mode does not guarantee unlimited storage."
                                   TextWrapping="Wrap" Opacity="0.75" />
                        <ToggleSwitch x:Name="MirrorFoldersToggle" Header="Create Google Photos albums for folders"
                                      Toggled="MirrorFolders_Toggled" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </NavigationView>
</Window>
